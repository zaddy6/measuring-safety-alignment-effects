{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/security-agent/task_manifest.schema.json",
  "title": "Security Agent Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_class",
    "container_image",
    "entrypoint",
    "time_limit_seconds",
    "max_model_calls",
    "allowed_tools",
    "forbidden_actions",
    "initial_prompt",
    "ground_truth",
    "grounding_targets",
    "success_predicate",
    "redaction_rule",
    "expected_artifacts"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "task_class": {
      "type": "string",
      "enum": [
        "vulnerability_localization",
        "reachability_validation",
        "proof_of_trigger",
        "patch_verification",
        "security_report_writing",
        "non_security_code_reasoning"
      ]
    },
    "container_image": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "time_limit_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_model_calls": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "initial_prompt": {
      "type": "string",
      "minLength": 1
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": true
    },
    "grounding_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "symbols",
        "issue_terms",
        "evidence_terms"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issue_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "success_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file_match",
            "command_exit_and_output",
            "service_state",
            "report_rubric",
            "custom_checker"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "checker": {
          "type": "string"
        },
        "expected": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "redaction_rule": {
      "type": "string",
      "minLength": 1
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewer_notes": {
      "type": "string"
    }
  }
}
